{
  "name": "naldstudio-com",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "observability": { "enabled": true },
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/products", "/products.html", "/services", "/services.html"]
  }
}
